    given-names: Roy T.
    orcid: "https://orcid.org/0000-0002-9997-5515"
  - family-names: Parker
    given-names: Jacob D.
    orcid: "https://orcid.org/0000-0001-8732-8284"
repository-code: "https://github.com/sun-data/named-arrays"
url: "https://named-arrays.readthedocs.io"
license: BSD-3-Clause
keywords:
  - named tensor
  - labeled arrays
  - NumPy
  - Astropy
  - uncertainty propagation
